{
  "components": {
    "responses": {
      "BadRequest": {
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        },
        "description": "请求有误（字段缺失、类型错、超限等），`error.type` 为 invalid_request_error"
      },
      "MethodNotAllowed": {
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        },
        "description": "该路径不支持此 HTTP 方法"
      },
      "ServerError": {
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        },
        "description": "生成/编码过程出错，`error.type` 为 server_error。注意：SSE 已经开始下发后只能在流内发一个 error 帧，拿不到本响应。"
      },
      "Unauthorized": {
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        },
        "description": "缺少或错误的 Authorization 头，`error.type` 为 authentication_error"
      }
    },
    "schemas": {
      "ChatCompletionChunk": {
        "description": "SSE 每一帧 data: 后面的 JSON（usage 帧的 choices 是空数组）",
        "properties": {
          "choices": {
            "items": {
              "properties": {
                "delta": {
                  "description": "首帧只有 role+空 content，其后是增量 content；finish 前可能有一帧只带 image_url（生成图片的 data URI）",
                  "properties": {
                    "content": {
                      "type": "string"
                    },
                    "image_url": {
                      "description": "生成图片的 data:image/png;base64 URI；仅当模型采出完整图片段且服务配了 vq.ckpt 时出现",
                      "type": "string"
                    },
                    "role": {
                      "type": "string"
                    }
                  },
                  "type": "object"
                },
                "finish_reason": {
                  "enum": [
                    "stop",
                    "length",
                    null
                  ],
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "index": {
                  "const": 0,
                  "type": "integer"
                }
              },
              "type": "object"
            },
            "type": "array"
          },
          "created": {
            "type": "integer"
          },
          "id": {
            "type": "string"
          },
          "model": {
            "type": "string"
          },
          "object": {
            "const": "chat.completion.chunk",
            "type": "string"
          },
          "usage": {
            "$ref": "#/components/schemas/Usage"
          }
        },
        "required": [
          "id",
          "object",
          "created",
          "model",
          "choices"
        ],
        "type": "object"
      },
      "ChatCompletionRequest": {
        "additionalProperties": true,
        "description": "认识的字段严格校验，不认识的忽略",
        "properties": {
          "max_tokens": {
            "description": "缺省用服务级 --max-new；超过 block_size 会被钳到窗口内",
            "minimum": 1,
            "type": "integer"
          },
          "messages": {
            "items": {
              "$ref": "#/components/schemas/ChatMessage"
            },
            "maxItems": 200,
            "minItems": 1,
            "type": "array"
          },
          "model": {
            "description": "可选；服务端固定用启动时加载的 checkpoint，该字段被忽略",
            "type": "string"
          },
          "n": {
            "const": 1,
            "description": "本服务一次只生成一个回答",
            "type": "integer"
          },
          "repetition_penalty": {
            "maximum": 10,
            "minimum": 0.1,
            "type": "number"
          },
          "repetition_window": {
            "maximum": 100000,
            "minimum": 0,
            "type": "integer"
          },
          "seed": {
            "description": "不给则用服务级 --seed",
            "minimum": 0,
            "type": "integer"
          },
          "stop": {
            "description": "缺省用服务级停止标记（SFT 模板标记）",
            "oneOf": [
              {
                "maxLength": 64,
                "minLength": 1,
                "type": "string"
              },
              {
                "items": {
                  "maxLength": 64,
                  "minLength": 1,
                  "type": "string"
                },
                "maxItems": 4,
                "minItems": 1,
                "type": "array"
              }
            ]
          },
          "stream": {
            "default": false,
            "type": "boolean"
          },
          "temperature": {
            "description": "缺省用服务级 --temperature",
            "maximum": 5,
            "minimum": 0,
            "type": "number"
          },
          "top_k": {
            "description": "0 = 不限制",
            "maximum": 10000,
            "minimum": 0,
            "type": "integer"
          },
          "top_p": {
            "exclusiveMinimum": 0,
            "maximum": 1,
            "type": "number"
          }
        },
        "required": [
          "messages"
        ],
        "type": "object"
      },
      "ChatCompletionResponse": {
        "properties": {
          "choices": {
            "items": {
              "properties": {
                "finish_reason": {
                  "enum": [
                    "stop",
                    "length"
                  ],
                  "type": "string"
                },
                "index": {
                  "const": 0,
                  "type": "integer"
                },
                "logprobs": {
                  "type": "null"
                },
                "message": {
                  "properties": {
                    "content": {
                      "type": "string"
                    },
                    "image_url": {
                      "description": "生成图片的 data:image/png;base64 URI；只有模型采出完整图片段且服务配了 vq.ckpt 时才有此字段",
                      "type": "string"
                    },
                    "role": {
                      "const": "assistant",
                      "type": "string"
                    }
                  },
                  "type": "object"
                }
              },
              "type": "object"
            },
            "type": "array"
          },
          "created": {
            "type": "integer"
          },
          "id": {
            "examples": [
              "chatcmpl-1"
            ],
            "type": "string"
          },
          "model": {
            "type": "string"
          },
          "object": {
            "const": "chat.completion",
            "type": "string"
          },
          "usage": {
            "$ref": "#/components/schemas/Usage"
          }
        },
        "required": [
          "id",
          "object",
          "created",
          "model",
          "choices",
          "usage"
        ],
        "type": "object"
      },
      "ChatMessage": {
        "properties": {
          "content": {
            "type": "string"
          },
          "image_url": {
            "description": "可选；只认最后一条 user 消息。输入图的 base64 data URI（data:image/png;base64,...）或裸 base64；服务配了视觉塔（config 的 model.vision）才接受，否则 400",
            "type": "string"
          },
          "role": {
            "description": "system/developer 汇成人设，最后一条必须是 user",
            "enum": [
              "system",
              "developer",
              "user",
              "assistant"
            ],
            "type": "string"
          }
        },
        "required": [
          "role",
          "content"
        ],
        "type": "object"
      },
      "EmbeddingRequest": {
        "additionalProperties": true,
        "properties": {
          "input": {
            "description": "字符串、token id，或它们的数组（一批最多 32 条）",
            "oneOf": [
              {
                "type": "string"
              },
              {
                "minimum": 0,
                "type": "integer"
              },
              {
                "items": {
                  "oneOf": [
                    {
                      "type": "string"
                    },
                    {
                      "minimum": 0,
                      "type": "integer"
                    }
                  ]
                },
                "maxItems": 32,
                "minItems": 1,
                "type": "array"
              }
            ]
          },
          "model": {
            "description": "可选，被忽略（向量来自已加载的 checkpoint）",
            "type": "string"
          }
        },
        "required": [
          "input"
        ],
        "type": "object"
      },
      "EmbeddingResponse": {
        "properties": {
          "data": {
            "items": {
              "properties": {
                "embedding": {
                  "items": {
                    "type": "number"
                  },
                  "type": "array"
                },
                "index": {
                  "type": "integer"
                },
                "object": {
                  "const": "embedding",
                  "type": "string"
                }
              },
              "type": "object"
            },
            "type": "array"
          },
          "model": {
            "type": "string"
          },
          "object": {
            "const": "list",
            "type": "string"
          },
          "usage": {
            "properties": {
              "prompt_tokens": {
                "type": "integer"
              },
              "total_tokens": {
                "type": "integer"
              }
            },
            "type": "object"
          }
        },
        "required": [
          "object",
          "data",
          "model",
          "usage"
        ],
        "type": "object"
      },
      "Error": {
        "properties": {
          "error": {
            "properties": {
              "code": {
                "description": "与 HTTP 状态码相同",
                "type": "integer"
              },
              "message": {
                "description": "给开发者看的中文错误说明",
                "type": "string"
              },
              "type": {
                "enum": [
                  "invalid_request_error",
                  "authentication_error",
                  "not_found",
                  "server_error"
                ],
                "type": "string"
              }
            },
            "required": [
              "message",
              "type",
              "code"
            ],
            "type": "object"
          }
        },
        "required": [
          "error"
        ],
        "type": "object"
      },
      "Health": {
        "properties": {
          "model": {
            "description": "checkpoint 文件名",
            "type": "string"
          },
          "status": {
            "const": "ok",
            "type": "string"
          }
        },
        "required": [
          "status",
          "model"
        ],
        "type": "object"
      },
      "ModelList": {
        "properties": {
          "data": {
            "items": {
              "properties": {
                "created": {
                  "type": "integer"
                },
                "id": {
                  "description": "checkpoint 文件名",
                  "type": "string"
                },
                "object": {
                  "const": "model",
                  "type": "string"
                },
                "owned_by": {
                  "type": "string"
                }
              },
              "required": [
                "id",
                "object",
                "created",
                "owned_by"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "object": {
            "const": "list",
            "type": "string"
          }
        },
        "required": [
          "object",
          "data"
        ],
        "type": "object"
      },
      "Status": {
        "properties": {
          "model": {
            "properties": {
              "block_size": {
                "type": "integer"
              },
              "max_new": {
                "type": "integer"
              },
              "name": {
                "type": "string"
              },
              "prompt_format": {
                "enum": [
                  "sft",
                  "raw"
                ],
                "type": "string"
              }
            },
            "type": "object"
          },
          "queue": {
            "description": "queued = 已进队还没拿到模型锁；running = 正在生成/编码",
            "properties": {
              "queued": {
                "type": "integer"
              },
              "running": {
                "type": "integer"
              }
            },
            "type": "object"
          },
          "requests": {
            "properties": {
              "chat": {
                "description": "非流式请求数",
                "type": "integer"
              },
              "embeddings": {
                "type": "integer"
              },
              "errors": {
                "type": "integer"
              },
              "stream": {
                "description": "流式请求数",
                "type": "integer"
              }
            },
            "type": "object"
          },
          "status": {
            "const": "ok",
            "type": "string"
          },
          "uptime_seconds": {
            "type": "integer"
          }
        },
        "required": [
          "status",
          "queue",
          "requests",
          "model"
        ],
        "type": "object"
      },
      "Usage": {
        "properties": {
          "completion_tokens": {
            "type": "integer"
          },
          "prompt_tokens": {
            "type": "integer"
          },
          "tokens_per_second": {
            "description": "服务端实测的纯解码段生成速率（tok/s，不含 prefill，也不受网络/缓冲影响）；生成 token 数不足 2 时为 null",
            "type": [
              "number",
              "null"
            ]
          },
          "total_tokens": {
            "type": "integer"
          }
        },
        "required": [
          "prompt_tokens",
          "completion_tokens",
          "total_tokens"
        ],
        "type": "object"
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "description": "所有业务端点都要带 `Authorization: Bearer <key>`：key 取启动时的 `--api-key`，没给则启动时自动生成随机 key 并打印在控制台启动日志里（`/health`、`/v1/status`、`/openapi.*` 不鉴权）。\n导入 Postman/Apifox 后，只需在 collection 的 Authorization → Bearer Token 里填一次 key，无需逐请求设置。",
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "description": "把本项目训练/微调出的单个 checkpoint 包装成 OpenAI 兼容接口。\n特性：SSE 流式输出、背压队列、客户端断开即中止、API key 鉴权、CORS、请求日志、/v1/status 队列诊断。",
    "license": {
      "name": "MIT"
    },
    "title": "llm-from-scratch 本地模型 API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/health": {
      "get": {
        "description": "不鉴权。进程活着就回 200，给网关/负载均衡当探针用。",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            },
            "description": "服务正常"
          }
        },
        "security": [],
        "summary": "存活探针",
        "tags": [
          "health"
        ]
      }
    },
    "/openapi.json": {
      "get": {
        "description": "不鉴权。本文件自身，可直接喂给 Swagger UI / Postman / Apifox。",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            },
            "description": "OpenAPI 3.1 文档"
          }
        },
        "security": [],
        "summary": "OpenAPI 规范（JSON）",
        "tags": [
          "health"
        ]
      }
    },
    "/openapi.yaml": {
      "get": {
        "description": "不鉴权。与 /openapi.json 同源，只是序列化格式不同。",
        "responses": {
          "200": {
            "content": {
              "text/yaml": {
                "schema": {
                  "type": "object"
                }
              }
            },
            "description": "OpenAPI 3.1 文档"
          }
        },
        "security": [],
        "summary": "OpenAPI 规范（YAML）",
        "tags": [
          "health"
        ]
      }
    },
    "/v1/chat/completions": {
      "post": {
        "description": "本服务的核心端点。\n`stream=false`（缺省）回一个完整的 chat.completion 对象；\n`stream=true` 回 SSE（`text/event-stream`），帧顺序为：role 帧 → content 增量帧… → finish_reason 帧 → usage 帧 → `data: [DONE]`。\n单份模型互斥排队，多个并发请求会依次执行；客户端断开连接会立即中止本次生成。\n未在 schema 中声明的字段一律忽略（OpenAI 客户端带的 `user`、`logit_bias` 等不会报错），声明了的字段严格校验。",
        "requestBody": {
          "content": {
            "application/json": {
              "example": {
                "max_tokens": 64,
                "messages": [
                  {
                    "content": "你是一个简洁的中文助手。",
                    "role": "system"
                  },
                  {
                    "content": "用一句话介绍 Transformer。",
                    "role": "user"
                  }
                ],
                "model": "latest",
                "stream": false,
                "temperature": 0.7
              },
              "schema": {
                "$ref": "#/components/schemas/ChatCompletionRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChatCompletionResponse"
                }
              },
              "text/event-stream": {
                "schema": {
                  "description": "每帧形如 `data: {…}\\n\\n`，最后一帧是 `data: [DONE]`；增量帧的结构见 ChatCompletionChunk。",
                  "type": "string"
                }
              }
            },
            "description": "补全结果（非流式为 JSON，流式为 SSE 事件流）"
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "405": {
            "$ref": "#/components/responses/MethodNotAllowed"
          },
          "500": {
            "$ref": "#/components/responses/ServerError"
          }
        },
        "summary": "对话补全（可流式）",
        "tags": [
          "chat"
        ]
      }
    },
    "/v1/embeddings": {
      "post": {
        "description": "取模型最后一层 hidden states 按 token 均值池化成一个向量。\n`input` 可以是字符串、token id，或它们的数组（一批最多 32 条）；超长输入只保留窗口内的尾部。",
        "requestBody": {
          "content": {
            "application/json": {
              "example": {
                "input": "用一句话介绍 Transformer。",
                "model": "latest"
              },
              "schema": {
                "$ref": "#/components/schemas/EmbeddingRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EmbeddingResponse"
                }
              }
            },
            "description": "向量列表"
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "405": {
            "$ref": "#/components/responses/MethodNotAllowed"
          },
          "500": {
            "$ref": "#/components/responses/ServerError"
          }
        },
        "summary": "文本向量化",
        "tags": [
          "embeddings"
        ]
      }
    },
    "/v1/models": {
      "get": {
        "description": "OpenAI 风格的模型列表。本服务只加载一个 checkpoint，所以 data 恒为一条。",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ModelList"
                }
              }
            },
            "description": "模型列表"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "405": {
            "$ref": "#/components/responses/MethodNotAllowed"
          }
        },
        "summary": "模型列表",
        "tags": [
          "models"
        ]
      }
    },
    "/v1/status": {
      "get": {
        "description": "不鉴权。看当前排队/运行中的请求数、各类请求累计计数与模型配置。",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Status"
                }
              }
            },
            "description": "当前状态"
          }
        },
        "security": [],
        "summary": "队列与计数（诊断用）",
        "tags": [
          "health"
        ]
      }
    }
  },
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "servers": [
    {
      "description": "启动时监听的地址（见 --host / --port）",
      "url": "http://127.0.0.1:8080"
    }
  ],
  "tags": [
    {
      "description": "对话补全",
      "name": "chat"
    },
    {
      "description": "向量化",
      "name": "embeddings"
    },
    {
      "description": "模型信息",
      "name": "models"
    },
    {
      "description": "探针与自描述（不鉴权）",
      "name": "health"
    }
  ]
}